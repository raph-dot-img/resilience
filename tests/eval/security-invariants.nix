# Evaluation-time security invariants of the real system configurations.
# Runs in seconds (nothing heavy is built) as the `security-invariants` check.
# A violated invariant makes evaluation fail with the list of violations.
{
  lib,
  configurations,
  writeText,
}:

let
  check =
    name: cfg:
    let
      c = cfg.config;
      root = c.users.users.root;
      humans = lib.filterAttrs (_: u: u.isNormalUser) c.users.users;
      # Our tty1-only autologin (interface.nix); services.getty.autologinUser
      # must stay unset because it applies to every console.
      autologin = c.resilience.interface.autologinUser;
      invariants = {
        "root password is locked" =
          root.hashedPassword == "!"
          && root.initialHashedPassword == null
          && root.password == null
          && root.initialPassword == null
          && root.hashedPasswordFile == null;
        "ssh is disabled" = !c.services.openssh.enable;
        "sudo requires a password" = c.security.sudo.wheelNeedsPassword;
        "only wheel may execute sudo" = c.security.sudo.execWheelOnly;
        "firewall is enabled" = c.networking.firewall.enable;
        "no open firewall ports" =
          c.networking.firewall.allowedTCPPorts == [ ] && c.networking.firewall.allowedUDPPorts == [ ];
        "no NTP in the background" = !c.services.timesyncd.enable;
        "no X server" = !c.services.xserver.enable;
        "nix daemon refuses ultra-stable accounts" =
          !(lib.elem "*" c.nix.settings.allowed-users) && !(lib.elem "@users" c.nix.settings.allowed-users);
        "only root is a trusted nix user" = lib.unique c.nix.settings.trusted-users == [ "root" ];
        "every human account uses the Resilience session" = lib.all (
          u: u.shell == c.resilience.sessionPackage
        ) (lib.attrValues humans);
        "polkit administrators are exactly the wheel group" =
          c.security.polkit.adminIdentities == [ "unix-group:wheel" ];
        "faillock rate-limits login, su, sudo and polkit" =
          lib.all (s: lib.hasInfix "pam_faillock.so" c.security.pam.services.${s}.text)
            [
              "login"
              "su"
              "sudo"
              "polkit-1"
            ];
        # Clock (ADR 0009): only through the helper's auth_admin action;
        # timedated keeps its upstream defaults.
        "no polkit rule relaxes Resilience or timedated actions" =
          !lib.hasInfix "org.resilience" c.security.polkit.extraConfig
          && !lib.hasInfix "timedate1" c.security.polkit.extraConfig;
        # Wi-Fi (ADR 0010): without the networkmanager group, NetworkManager
        # allows only scanning, connecting, own profiles and the radio.
        "NetworkManager is restricted for accounts without its group" =
          !c.networking.networkmanager.enable
          || lib.hasInfix "Resilience (ADR 0010)" c.security.polkit.extraConfig;
        "privileged helper configuration is generated by Nix" = c.environment.etc ? "resilience/admin.toml";
        "getty autologin is not used (it would apply to every console)" =
          c.services.getty.autologinUser == null;
        # Removable media (ADR 0008): udisks2's own polkit defaults decide;
        # nothing may widen them (e.g. internal disks without a password).
        "no polkit rule overrides udisks2" = !lib.hasInfix "udisks" c.security.polkit.extraConfig;
        "removable media mount per user under /run/media" =
          !c.services.udisks2.enable || !c.services.udisks2.mountOnMedia;
        "backup tool has no privileges" =
          !(c.security.wrappers ? resilience-backup) && !(c.security.wrappers ? resilience);
        # ADR 0012: an Ultra-Stable-only machine refuses user namespaces.
        "user namespaces are off when every account is Ultra-Stable" =
          !(
            lib.all (u: u.mode == "ultra-stable") (lib.attrValues c.resilience.users)
            && lib.all (n: c.resilience.users ? ${n}) (lib.attrNames humans)
          )
          || (
            (c.boot.kernel.sysctl."user.max_user_namespaces" or null) == 0
            # Read by admin.nix as `ultra_stable_only` in admin.toml.
            && !c.resilience.security.userNamespaces
          );
        # ADR 0013: packs are written by an unprivileged system account only.
        # ADR 0015: like age and minisign, GnuPG asks every time; no setuid
        # crypto helper exists.
        "gpg-agent keeps no passphrase in its cache" =
          c.programs.gnupg.agent.settings.default-cache-ttl or null == 0
          && c.programs.gnupg.agent.settings.max-cache-ttl or null == 0;
        "no cryptography program runs with privileges" = !(lib.any (
          n: lib.elem n [
            "resilience-crypto"
            "age"
            "minisign"
            "gpg"
          ]
        ) (lib.attrNames c.security.wrappers));
        "pack store is an unprivileged system account" =
          !c.resilience.packs.enable
          || (
            c.users.users.resilience-packs.isSystemUser
            && c.users.users.resilience-packs.extraGroups == [ ]
            && c.users.users.resilience-packs.group == "resilience-packs"
            && !(c.security.wrappers ? resilience-pack-store)
            && !(c.security.wrappers ? resilience-library)
          );
        "installed packs are writable by the pack store only" =
          !c.resilience.packs.enable
          || lib.elem "d ${c.resilience.packs.dir} 0755 resilience-packs resilience-packs -" c.systemd.tmpfiles.rules;
        "autologin account is not privileged" =
          autologin == null
          || lib.intersectLists [ "wheel" "resilience-stable" ] c.users.users.${autologin}.extraGroups == [ ];
      };
      failed = lib.attrNames (lib.filterAttrs (_: ok: !ok) invariants);
    in
    if failed == [ ] then
      "${name}: ${toString (lib.length (lib.attrNames invariants))} invariants hold"
    else
      throw "security invariants violated in ${name}: ${lib.concatStringsSep "; " failed}";
in
writeText "security-invariants-report" (
  lib.concatStringsSep "\n" (lib.mapAttrsToList check configurations) + "\n"
)
